# Azure credentials (required for Azure ML training and data management)
AZURE_SUBSCRIPTION_ID=<your-subscription-id-here>
AZURE_RESOURCE_GROUP=rg-rock-joint-detection
AZURE_ML_WORKSPACE=ws-rock-joint-det

# Azure Storage (required for dataset management)
AZURE_BLOB_DATASTORE=<blob-datastore-name>
AZURE_STORAGE_ACCOUNT=<storage-account-name>
AZURE_STORAGE_KEY=<storage-access-key>

# Azure ML Compute Target (required for training)
AZURE_ML_COMPUTE=<compute-cluster-name>

# MLflow tracking (optional, for local experiments)
MLFLOW_TRACKING_URI=<mlflow-server-uri-or-file-path>

# Python environment
PYTHONPATH=src
